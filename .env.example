# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Per-agent model overrides (defaults shown)
REASONER_MODEL=claude-opus-4-8
VERIFIER_MODEL=claude-opus-4-8
PLANNER_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5

# --- Embeddings / reranking (Voyage AI) ---
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3
RERANK_MODEL=rerank-2

# --- Storage ---
DATABASE_URL=postgresql+psycopg://docsai:docsai@localhost:5432/docsai
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=docsai-neo4j

# --- Telegram bot (optional; bot exits if unset) ---
TELEGRAM_BOT_TOKEN=

# --- Optional: LlamaParse for high-quality table parsing (Docling used otherwise) ---
LLAMAPARSE_API_KEY=

# --- Backend ---
# Where original uploaded files are stored (docker-compose mounts a volume here)
UPLOAD_DIR=data/uploads
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Verifier loops back to retrieval below this confidence (0-100)
MIN_CONFIDENCE=60
